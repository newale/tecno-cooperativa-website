---
layout: base.njk
title: Estado
description: "Estado de la infraestructura de Tecnocoop: salud general, almacenamiento y servicios."
permalink: /estado/
---
{% set freeGb = (status.storage.totalGb - status.storage.usedGb) | round(1) %}
{% set usedPct = (status.storage.usedGb / status.storage.totalGb * 100) | round(1) %}
{% set badgeLabels = { ok: "Operativo", degraded: "Degradado", down: "Caído", disabled: "No disponible" } %}
<section class="page-content" data-estado-page>
  <div class="wrap">
    <p class="lede">Salud general de los servicios de {{ site.name }}, actualizada por última vez el <span data-field="date">{{ status.date }}</span>.</p>

    <div class="status-banner status-banner--{{ status.overall.state }}" data-field="overall-banner">
      <span class="status-dot"></span>
      <span data-field="overall-label">{{ status.overall.label }}</span>
    </div>

    <h1 class="section-title">General</h1>

    <h2>Consumo eléctrico</h2>
    <div class="status-card">
      <div class="status-card__header">
        <h3>Consumo eléctrico</h3>
        <span class="status-badge status-badge--ok">Operativo</span>
      </div>
      <p>Energía consumida por la infraestructura de la cooperativa.</p>
      <div class="service-stats">
        <div>
          <strong data-field="kwh-today">{{ status.kwhToday }} kWh</strong>
          <span>Consumo hoy</span>
        </div>
      </div>
    </div>

    <h2>Almacenamiento</h2>
    <div class="status-card">
      <div class="status-card__header">
        <h3>Espacio en disco</h3>
        <span class="status-badge status-badge--ok">Operativo</span>
      </div>
      <div class="storage-bar" role="img" data-field="storage-bar" aria-label="{{ status.storage.usedGb }} GB usados de {{ status.storage.totalGb }} GB">
        <div class="storage-bar__used" data-field="storage-bar-fill" style="width: {{ usedPct }}%;"></div>
      </div>
      <div class="storage-stats">
        <div>
          <strong data-field="storage-used">{{ status.storage.usedGb }} GB</strong>
          <span>usados</span>
        </div>
        <div>
          <strong data-field="storage-free">{{ freeGb }} GB</strong>
          <span>disponibles</span>
        </div>
        <div>
          <strong data-field="storage-total">{{ status.storage.totalGb }} GB</strong>
          <span>totales</span>
        </div>
      </div>
    </div>

    <h1 class="section-title">Servicios</h1>
    <div class="status-list">
      <div class="status-card">
        <div class="status-card__header">
          <h3>Pods (Solid)</h3>
          <span class="status-badge status-badge--ok">Operativo</span>
        </div>
        <p>Almacenamiento de datos personales bajo el estándar Solid.</p>
        <div class="service-stats">
          <div>
            <strong data-field="pod-count">{{ status.podCount }}</strong>
            <span>Pods activos</span>
          </div>
        </div>
      </div>

      {% for service in status.services %}
      <div class="status-card{% if service.state == 'disabled' %} status-card--disabled{% endif %}">
        <div class="status-card__header">
          <h3>{{ service.name }}</h3>
          <span class="status-badge status-badge--{{ service.state }}">{{ badgeLabels[service.state] }}</span>
        </div>
        <p>{{ service.description }}</p>
        {% if service.stats and service.stats.length %}
        <div class="service-stats">
          {% for stat in service.stats %}
          <div>
            <strong>{{ stat.value }}</strong>
            <span>{{ stat.label }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    <p class="status-source-note" data-field="source-note">Datos en vivo desde status-tc.aebn.cl.</p>
  </div>
</section>
